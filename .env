# Le serveur de développement de react-scripts n'autorise qu'un seul nom
# d'hôte : l'IP LAN qu'il détecte (ici 10.1.1.19). Tout autre nom — dont
# babibel.ibmp.unistra.fr — reçoit « Invalid Host header ».
#
# Cette protection vise le DNS rebinding : un site malveillant pourrait
# faire pointer un nom qu'il contrôle vers cette machine et parler au
# serveur de développement depuis le navigateur d'un visiteur. Le risque
# est réel mais borné : serveur de développement, sur le réseau de
# l'institut, allumé seulement pendant le travail et la démo.
#
# Ne concerne QUE le serveur de développement, jamais l'API FastAPI.
DANGEROUSLY_DISABLE_HOST_CHECK=true
